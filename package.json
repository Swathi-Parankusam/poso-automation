{
  "name": "poso-automation",
  "version": "1.0.0",
  "description": "POSO automation using Playwright, TypeScript, and Cucumber BDD",
  "main": "index.js",
  "scripts": {
    "test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --import ./support/world.ts --import ./support/hooks.ts --import ./step-definitions/login.steps.ts --import ./step-definitions/underwriters.steps.ts --import ./step-definitions/products.steps.ts --import ./step-definitions/rating.steps.ts --import ./step-definitions/leads.steps.ts --format progress --format html:reports/cucumber-report.html"
  },
  "keywords": [
    "playwright",
    "typescript",
    "cucumber",
    "bdd",
    "automation",
    "poso"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.7"
  }
}